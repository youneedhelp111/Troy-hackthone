# Optional — StudyPal asks for your API key in the browser on first launch,
# and saves it locally (data/studypal.db). You do NOT need to create a .env.
# Only set these if you prefer environment variables over the web UI.
DEEPSEEK_KEY=
DEEPSEEK_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# Embeddings: "ollama" (local, recommended) or "none" (BM25-only, fully cloud).
EMBED_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

MAX_UPLOAD_MB=40
MAX_DOCS=60
